diff --git a/lib/services/schedule_plan.dart b/lib/services/schedule_plan.dart
new file mode 100644
index 0000000..896a3f6
--- /dev/null
+++ b/lib/services/schedule_plan.dart
@@ -0,0 +1,97 @@
+import '../models/bill.dart';
+
+/// Satu pengingat yang akan dikirim.
+class PlannedReminder {
+  const PlannedReminder({
+    required this.id,
+    required this.bill,
+    required this.offset,
+    required this.fireDate,
+  });
+
+  final int id;
+  final Bill bill;
+
+  /// H-berapa (7, 3, 1, ...).
+  final int offset;
+  final DateTime fireDate;
+}
+
+/// Rencana pengingat dari daftar tagihan saat ini — murni (tanpa plugin),
+/// supaya aturannya bisa diuji tanpa perangkat.
+///
+/// Dulu setiap perubahan data memanggil `cancelAll()` lalu menjadwalkan ulang
+/// hanya yang masih di masa depan. Akibatnya notifikasi yang SUDAH TAMPIL
+/// (termasuk yang sticky) ikut terhapus dan tidak pernah muncul lagi, mis.
+/// ketika tagihan lain dilunasi atau aplikasi baru dibuka. Rencana ini
+/// membedakan tiga golongan supaya pembersihannya selektif:
+///
+///  * [upcoming] — belum waktunya; dijadwalkan.
+///  * [fired] — sudah waktunya untuk periode jatuh tempo yang berlaku saat
+///    ini; kalau tampil di bilah notifikasi, biarkan.
+///  * selain keduanya — basi (tagihan dilunasi/dihapus, jatuh tempo
+///    bergeser, H- dihilangkan); dibatalkan.
+class SchedulePlan {
+  SchedulePlan._(this.upcoming, this.fired);
+
+  /// Id -> pengingat yang belum waktunya.
+  final Map<int, PlannedReminder> upcoming;
+
+  /// Id pengingat yang waktunya sudah lewat untuk jatuh tempo yang berlaku.
+  final Set<int> fired;
+
+  // Notifikasi dikirim pukul 08:00 waktu lokal pada hari pengingat.
+  static const int fireHour = 8;
+  static const int fireMinute = 0;
+
+  /// Id notifikasi untuk satu pengingat.
+  ///
+  /// Tanggal jatuh tempo ikut dihitung, jadi tiap PERIODE punya id sendiri.
+  /// Setelah tagihan dilunasi dan jatuh temponya maju, notifikasi periode
+  /// lama yang masih tampil punya id yang tidak lagi ada di rencana, sehingga
+  /// bisa dikenali sebagai basi. Tanpa ini id-nya sama dan tidak bisa
+  /// dibedakan dari notifikasi periode baru.
+  static int notifId(String billId, int offset, DateTime dueDate) {
+    final hari = dueDate.year * 10000 + dueDate.month * 100 + dueDate.day;
+    return Object.hash(billId, offset, hari) & 0x7fffffff;
+  }
+
+  static DateTime fireDateFor(DateTime dueDate, int offset) {
+    final d = dueDate.subtract(Duration(days: offset));
+    return DateTime(d.year, d.month, d.day, fireHour, fireMinute);
+  }
+
+  factory SchedulePlan.build(List<Bill> bills, DateTime now) {
+    final upcoming = <int, PlannedReminder>{};
+    final fired = <int>{};
+    for (final bill in bills) {
+      for (final offset in bill.reminderOffsets) {
+        final id = notifId(bill.id, offset, bill.dueDate);
+        final fireDate = fireDateFor(bill.dueDate, offset);
+        if (fireDate.isBefore(now)) {
+          fired.add(id);
+        } else {
+          upcoming[id] = PlannedReminder(
+            id: id,
+            bill: bill,
+            offset: offset,
+            fireDate: fireDate,
+          );
+        }
+      }
+    }
+    return SchedulePlan._(upcoming, fired);
+  }
+
+  /// Id jadwal tertunda yang harus dibatalkan: yang tidak ada di [upcoming].
+  Set<int> pendingToCancel(Iterable<int> pendingIds) => {
+    for (final id in pendingIds)
+      if (!upcoming.containsKey(id)) id,
+  };
+
+  /// Id notifikasi tampil yang harus dihapus: yang bukan [fired] berlaku.
+  Set<int> activeToCancel(Iterable<int> activeIds) => {
+    for (final id in activeIds)
+      if (!fired.contains(id)) id,
+  };
+}
diff --git a/test/schedule_plan_test.dart b/test/schedule_plan_test.dart
new file mode 100644
index 0000000..b0636ae
--- /dev/null
+++ b/test/schedule_plan_test.dart
@@ -0,0 +1,175 @@
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:pengingat_tagihan/models/bill.dart';
+import 'package:pengingat_tagihan/services/schedule_plan.dart';
+
+// Sekarang: 25 Okt 2026 pukul 09:00. Notifikasi dikirim pukul 08:00 hari
+// pengingat, jadi pengingat 25 Okt sudah lewat 1 jam.
+final _now = DateTime(2026, 10, 25, 9, 0);
+
+Bill _bill(
+  String id,
+  DateTime dueDate, {
+  List<int> offsets = const [7, 3, 1],
+  int every = 1,
+  RepeatUnit unit = RepeatUnit.bulan,
+}) {
+  return Bill(
+    id: id,
+    name: 'Tagihan $id',
+    type: BillType.tagihan,
+    repeatEvery: every,
+    repeatUnit: unit,
+    dueDate: dueDate,
+    reminderOffsets: offsets,
+    estimatedCost: 100000,
+    paymentMethod: 'Dana',
+    createdAt: DateTime(2026, 1, 1),
+  );
+}
+
+int _id(String billId, int offset, DateTime due) =>
+    SchedulePlan.notifId(billId, offset, due);
+
+void main() {
+  group('pembagian pengingat', () {
+    test('yang waktunya sudah lewat = fired, sisanya = upcoming', () {
+      // Jatuh tempo 27 Okt: H-7 (20 Okt) dan H-3 (24 Okt) sudah lewat,
+      // H-1 (26 Okt) belum.
+      final due = DateTime(2026, 10, 27);
+      final plan = SchedulePlan.build([_bill('a', due)], _now);
+
+      expect(plan.fired, {_id('a', 7, due), _id('a', 3, due)});
+      expect(plan.upcoming.keys, [_id('a', 1, due)]);
+      expect(plan.upcoming[_id('a', 1, due)]!.offset, 1);
+      expect(
+        plan.upcoming[_id('a', 1, due)]!.fireDate,
+        DateTime(2026, 10, 26, 8, 0),
+      );
+    });
+
+    test('fireDateFor: pukul 08:00, H-n sebelum jatuh tempo', () {
+      expect(
+        SchedulePlan.fireDateFor(DateTime(2026, 1, 31), 3),
+        DateTime(2026, 1, 28, 8, 0),
+      );
+      expect(
+        SchedulePlan.fireDateFor(DateTime(2026, 3, 2), 7),
+        DateTime(2026, 2, 23, 8, 0),
+      );
+    });
+
+    test('tanpa tagihan: rencana kosong', () {
+      final plan = SchedulePlan.build(const [], _now);
+      expect(plan.upcoming, isEmpty);
+      expect(plan.fired, isEmpty);
+    });
+  });
+
+  group('id notifikasi', () {
+    final due = DateTime(2026, 11, 5);
+
+    test('sama untuk masukan yang sama', () {
+      expect(_id('a', 3, due), _id('a', 3, due));
+    });
+
+    test('berbeda per tagihan, per H-, dan per periode jatuh tempo', () {
+      final ids = {
+        _id('a', 3, due),
+        _id('b', 3, due),
+        _id('a', 1, due),
+        _id('a', 3, DateTime(2026, 12, 5)),
+      };
+      expect(ids, hasLength(4));
+    });
+
+    test('jam di tanggal jatuh tempo tidak mengubah id', () {
+      expect(
+        _id('a', 3, DateTime(2026, 11, 5)),
+        _id('a', 3, DateTime(2026, 11, 5, 14, 30)),
+      );
+    });
+
+    test('selalu non-negatif (syarat id notifikasi Android)', () {
+      for (var i = 0; i < 200; i++) {
+        expect(_id('bill-$i', i % 8, DateTime(2026, 1, 1 + i % 28)), isNonNegative);
+      }
+    });
+  });
+
+  group('pembersihan jadwal tertunda', () {
+    test('hanya yang tidak ada di rencana yang dibatalkan', () {
+      final due = DateTime(2026, 10, 27);
+      final plan = SchedulePlan.build([_bill('a', due)], _now);
+      final upcomingId = _id('a', 1, due);
+      const staleId = 12345;
+
+      expect(plan.pendingToCancel([upcomingId, staleId]), {staleId});
+    });
+
+    test('H- yang dihilangkan pengguna ikut dibatalkan', () {
+      final due = DateTime(2026, 11, 20);
+      final before = SchedulePlan.build([_bill('a', due)], _now);
+      final after = SchedulePlan.build([
+        _bill('a', due, offsets: const [7]),
+      ], _now);
+
+      final pending = before.upcoming.keys;
+      expect(after.pendingToCancel(pending), {
+        _id('a', 3, due),
+        _id('a', 1, due),
+      });
+    });
+  });
+
+  group('pembersihan notifikasi yang sedang tampil', () {
+    test('melunasi tagihan A tidak menghapus notifikasi tagihan B', () {
+      // Keduanya jatuh tempo 26 Okt; H-1 (25 Okt 08:00) sudah tampil.
+      final dueA = DateTime(2026, 10, 26);
+      final dueB = DateTime(2026, 10, 26);
+      final tampil = [_id('a', 1, dueA), _id('b', 1, dueB)];
+
+      // A dilunasi -> jatuh temponya maju sebulan. B tetap belum dibayar.
+      final setelahLunas = SchedulePlan.build([
+        _bill('a', DateTime(2026, 11, 26)),
+        _bill('b', dueB),
+      ], _now);
+
+      expect(setelahLunas.activeToCancel(tampil), {_id('a', 1, dueA)});
+    });
+
+    test('notifikasi tagihan yang telat dan belum dibayar tetap dipertahankan', () {
+      final due = DateTime(2026, 10, 20);
+      final plan = SchedulePlan.build([_bill('a', due)], _now);
+      final tampil = [_id('a', 1, due), _id('a', 3, due)];
+
+      expect(plan.activeToCancel(tampil), isEmpty);
+    });
+
+    test('tagihan yang dihapus: notifikasinya dibersihkan', () {
+      final due = DateTime(2026, 10, 26);
+      final plan = SchedulePlan.build(const [], _now);
+
+      expect(plan.activeToCancel([_id('a', 1, due)]), {_id('a', 1, due)});
+    });
+
+    test('tagihan mingguan: notifikasi periode lama basi walau H-7 periode '
+        'baru sudah lewat', () {
+      // Periode lama jatuh tempo 22 Okt (H-7 tampil). Dilunasi -> 30 Okt.
+      // H-7 periode baru (23 Okt) juga sudah lewat, tapi id-nya beda.
+      final lama = DateTime(2026, 10, 22);
+      final baru = DateTime(2026, 10, 30);
+      final plan = SchedulePlan.build([
+        _bill('a', baru, every: 1, unit: RepeatUnit.minggu),
+      ], _now);
+
+      expect(plan.fired, contains(_id('a', 7, baru)));
+      expect(plan.activeToCancel([_id('a', 7, lama)]), {_id('a', 7, lama)});
+    });
+
+    test('id luar rencana (bukan milik pengingat) tidak dipertahankan', () {
+      final plan = SchedulePlan.build(const [], _now);
+      expect(plan.activeToCancel([999]), {999});
+    });
+  });
+}
