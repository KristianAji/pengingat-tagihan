<?xml version="1.0" encoding="utf-8"?>
<!--
  Keterangan widget Home Screen (Fitur 4).

  updatePeriodMillis: Android membulatkan ini ke bawah ke 30 menit, dan itu
  memang yang diinginkan — tiap 30 menit widget digambar ulang sehingga
  hitungan harinya tetap benar walau aplikasi tidak dibuka berhari-hari.
  Datanya sendiri tidak berubah karenanya (isi tagihan tetap datang dari
  Flutter); yang dihitung ulang hanya teks "N hari lagi".
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000" />
