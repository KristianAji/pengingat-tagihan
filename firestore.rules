rules_version = '2';

// Aturan keamanan Firestore untuk aplikasi Pengingat Tagihan.
// Setiap pengguna hanya boleh membaca & menulis datanya sendiri
// di bawah dokumen users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
